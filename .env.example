# Copy to .env for local deployments. Never commit a real token.
#
# The token needs these account/zone permissions:
#   Workers Scripts: Edit, Workers Routes: Edit, D1: Edit, R2: Edit,
#   Zone: Read, DNS: Edit (Cloudflare creates the clip.naerdev.ch record
#   automatically when the Worker is deployed with a custom domain route).
#
# Create it at: Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
